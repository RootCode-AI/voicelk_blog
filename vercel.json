{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --include=dev --include=optional",
  "buildCommand": "npm run build",
  "outputDirectory": "client/dist",
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "includeFiles": "client/dist/index.html"
    }
  },
  "routes": [
    { "src": "/", "dest": "/api/index?__page=" },
    { "src": "/index\\.html", "status": 308, "headers": { "Location": "/" } },
    { "src": "/robots\\.txt", "dest": "/api/index?__page=robots.txt" },
    { "src": "/sitemap\\.xml", "dest": "/api/index?__path=sitemap" },
    { "src": "/api/(.*)", "dest": "/api/index?__path=$1" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/api/index?__page=$1" }
  ]
}
