{
  "name": "voicelk-blog",
  "private": true,
  "type": "module",
  "description": "VoiceLK product website: React client and Express API on MongoDB, with the listening evaluation on Supabase",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "test:ui": "playwright test",
    "test:seo": "node --test server/tests/seo.test.js",
    "test:sections": "node --test server/tests/sections.test.js",
    "test:evaluation": "node --test server/tests/evaluation.test.js",
    "test:access": "node --test server/tests/access.test.js",
    "test:emails": "node --test server/tests/emails.test.js",
    "test:config": "node --test server/tests/config.test.js",
    "dev": "concurrently -n api,web -c blue,magenta \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
    "start": "npm start -w server",
    "create-admin": "npm run create-admin -w server --",
    "delete-admin": "npm run delete-admin -w server --",
    "create-evaluator": "npm run create-evaluator -w server --",
    "db:setup": "npm run db:setup -w server"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "concurrently": "^10.0.5",
    "sharp": "^0.35.5"
  },
  "version": "1.0.0",
  "main": "server/src/index.js",
  "engines": {
    "node": "22.x"
  }
}
