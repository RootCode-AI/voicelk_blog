# Vercel production environment variables.
# Add these in Vercel Project > Settings > Environment Variables.
# Do not commit real secret values to Git.

MONGODB_URI=mongodb+srv://DB_USERNAME:DB_PASSWORD@YOUR_CLUSTER.mongodb.net/voicelk-dev?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-production-secret
NODE_ENV=production

# The client and API share one Vercel domain.
CLIENT_ORIGIN=https://voicelk.dev
PUBLIC_URL=https://voicelk.dev

# Rotate exposed credentials before deployment.
RESEND_API_KEY=re_replace_with_your_resend_api_key

# Use onboarding@resend.dev only for testing. Verify voicelk.dev before using this sender.
MAIL_FROM=VoiceLK <journal@voicelk.dev>
CONTACT_TO=rootcode.project@gmail.com

# Vercel Functions have a 4.5 MB request/response payload limit.
UPLOAD_LIMIT_MB=4

# Listening evaluation (/evaluate). Run server/supabase/evaluation.sql once in the
# Supabase SQL editor first. Use the secret key (Project Settings > API Keys, sb_secret_…):
# it is a server secret, so never put it in the client or a VITE_ variable. The
# publishable key and the JWKS URL are not needed: the browser never talks to Supabase
# directly and the blog does not use Supabase Auth. Leave these empty to switch the
# feature off. A legacy service_role key in SUPABASE_SERVICE_ROLE_KEY also works.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_with_your_secret_key
EVALUATION_AUDIO_BUCKET=evaluation-audio
# Only for `npm run db:setup`, which applies server/supabase/evaluation.sql from the
# command line: Dashboard > Connect > Session pooler. It holds the database password,
# so keep it local; do not add it to Vercel, the running site never needs it.
SUPABASE_DB_URL=
# Optional: Supabase's CA certificate (Database settings > SSL configuration) to verify it.
SUPABASE_DB_CA=
# Keys the one-way hash that limits each IP address to one response per clip.
# Defaults to JWT_SECRET; set it separately so rotating JWT_SECRET keeps the limit.
FEEDBACK_IP_SECRET=replace-with-another-long-random-secret
