# Vercel production environment variables.
# Add these in Vercel Project > Settings > Environment Variables.
# Do not commit real secret values to Git.

MONGODB_URI=mongodb+srv://DB_USERNAME:DB_PASSWORD@YOUR_CLUSTER.mongodb.net/voicelk_blog?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-production-secret
NODE_ENV=production

# The client and API share one Vercel domain.
CLIENT_ORIGIN=https://voicelk.dev
PUBLIC_URL=https://voicelk.dev

# Rotate exposed credentials before deployment.
RESEND_API_KEY=re_replace_with_your_resend_api_key

# Use onboarding@resend.dev only for testing. Verify voicelk.dev before using this sender.
MAIL_FROM=VoiceLK <journal@voicelk.dev>
CONTACT_TO=rootcode.project@gmail.com

# Vercel Functions have a 4.5 MB request/response payload limit.
UPLOAD_LIMIT_MB=4
