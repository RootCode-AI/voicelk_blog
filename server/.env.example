# MongoDB — local (mongodb://127.0.0.1:27017/voicelk_blog) or an Atlas connection string
MONGODB_URI=mongodb://127.0.0.1:27017/voicelk_blog

# Long random string used to sign admin sessions
JWT_SECRET=change-me-to-a-long-random-string

PORT=5000
NODE_ENV=development

# Where the React client runs (CORS) and the public URL used in email links
CLIENT_ORIGIN=http://localhost:5173
PUBLIC_URL=http://localhost:5173

# Resend — leave RESEND_API_KEY empty in development and emails are printed to the console
RESEND_API_KEY=
# Must be an address on a domain verified in Resend (onboarding@resend.dev only reaches your own inbox)
MAIL_FROM=VoiceLK Journal <onboarding@resend.dev>
# Inbox that receives contact-form messages
CONTACT_TO=

# Largest file the editor may upload (images, audio samples, video)
UPLOAD_LIMIT_MB=25
