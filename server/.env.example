# Render production environment variables.
# Add these in Render Dashboard > Web Service > Environment.
# Do not commit real secret values to Git.

# MongoDB Atlas connection string. Replace all placeholders and URL-encode special characters.
MONGODB_URI=mongodb+srv://DB_USERNAME:DB_PASSWORD@YOUR_CLUSTER.mongodb.net/voicelk_blog?retryWrites=true&w=majority

# Generate a unique random value of at least 32 bytes.
JWT_SECRET=replace-with-a-long-random-production-secret

NODE_ENV=production

# Client and API use the same Render Web Service origin.
# Use the onrender.com URL first, then replace both with https://voicelk.dev after adding the custom domain.
CLIENT_ORIGIN=https://YOUR-SERVICE-NAME.onrender.com
PUBLIC_URL=https://YOUR-SERVICE-NAME.onrender.com

# Render provides PORT automatically. Do not add PORT in the Render dashboard.

# Resend is used for contact messages and new-post emails.
RESEND_API_KEY=re_replace_with_your_resend_api_key

# Verify voicelk.dev in Resend before using this sender.
# The sender address does not need a mailbox, but its domain must be verified.
MAIL_FROM=VoiceLK Journal <journal@voicelk.dev>

# Real inbox that receives contact-form messages.
CONTACT_TO=rootcode.project@gmail.com

# Largest editor upload in megabytes.
UPLOAD_LIMIT_MB=25
